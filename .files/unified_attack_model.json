{
    "assets": [
        {
            "name": "Autonomous Driving System",
            "threats": [
                {
                    "name": "Unauthorized access",
                    "objectives": [
                        "Gain control over the vehicle",
                        "Steal sensitive data"
                    ],
                    "vectors": [
                        {
                            "vector_id": "vector_1",
                            "vector_name": "Wireless Intrusion via CAN Bus",
                            "scenarios": [
                                {
                                    "scenario_id": "scenario_1",
                                    "scenario_description": "The attacker uses a device to send malicious signals through the Controller Area Network (CAN) bus, overriding control systems such as braking or steering."
                                },
                                {
                                    "scenario_id": "scenario_2",
                                    "scenario_description": "Exploiting vulnerabilities in the CAN protocol to inject false commands that could lead to critical system failures."
                                }
                            ]
                        },
                        {
                            "vector_id": "vector_2",
                            "vector_name": "Remote Exploit via Infotainment System",
                            "scenarios": [
                                {
                                    "scenario_id": "scenario_3",
                                    "scenario_description": "The attacker exploits a zero-day vulnerability in the infotainment system to gain remote access, potentially enabling them to control vehicle functions or extract sensitive data."
                                },
                                {
                                    "scenario_id": "scenario_4",
                                    "scenario_description": "Performing social engineering attacks to trick users into downloading malicious software onto their mobile devices connected to the car's network."
                                }
                            ]
                        },
                        {
                            "vector_id": "vector_3",
                            "vector_name": "Phishing Attacks on Maintenance Personnel",
                            "scenarios": [
                                {
                                    "scenario_id": "scenario_5",
                                    "scenario_description": "The attacker sends phishing emails to maintenance staff, tricking them into clicking on malicious links or downloading malware that could compromise the vehicle's systems."
                                },
                                {
                                    "scenario_id": "scenario_6",
                                    "scenario_description": "Using social engineering tactics to obtain login credentials for maintenance and diagnostic tools used by service centers."
                                }
                            ]
                        }
                    ],
                    "controls": [
                        {
                            "control_id": "AC-1",
                            "control_name": "Access Control Policy",
                            "control_description": "Defines roles and permissions for system users to ensure that only authorized personnel can access the autonomous driving system.",
                            "control_type": "Preventive",
                            "implementation_priority": "High"
                        },
                        {
                            "control_id": "SC-1",
                            "control_name": "Secure Communication Protocols",
                            "control_description": "Utilizes secure communication protocols such as TLS/SSL to protect data in transit and prevent unauthorized access.",
                            "control_type": "Preventive",
                            "implementation_priority": "High"
                        },
                        {
                            "control_id": "SC-2",
                            "control_name": "Encryption of Sensitive Data",
                            "control_description": "Encrypts sensitive data both at rest and in transit to prevent unauthorized access or modification.",
                            "control_type": "Preventive",
                            "implementation_priority": "High"
                        },
                        {
                            "control_id": "AU-1",
                            "control_name": "Audit Logs and Monitoring",
                            "control_description": "Maintains comprehensive logs of system activities for monitoring and detecting unauthorized access attempts.",
                            "control_type": "Detective",
                            "implementation_priority": "Medium"
                        },
                        {
                            "control_id": "CM-1",
                            "control_name": "Continuous Software Updates",
                            "control_description": "Ensures timely updates and patches are applied to the autonomous driving system to fix known vulnerabilities.",
                            "control_type": "Corrective",
                            "implementation_priority": "High"
                        }
                    ]
                }
            ],
            "consequences": [
                "Loss of vehicle control",
                "Accident or collision",
                "Compromise of passenger safety",
                "Liability issues"
            ]
        },
        {
            "name": "Infotainment System",
            "threats": [
                {
                    "name": "Malicious app installation",
                    "objectives": [
                        "Gain unauthorized access to vehicle data",
                        "Control infotainment system functions"
                    ],
                    "vectors": [
                        {
                            "vector_id": "vector_1",
                            "vector_name": "Exploit Vulnerabilities in App Store",
                            "scenarios": [
                                {
                                    "scenario_id": "scenario_1",
                                    "scenario_description": "Attacker develops a malicious app and uploads it to an unsecured or compromised app store. When the infotainment system checks for updates, it downloads and installs this app without proper validation."
                                },
                                {
                                    "scenario_id": "scenario_2",
                                    "scenario_description": "Attacker exploits known vulnerabilities in the app store's authentication or update mechanisms to bypass security checks and push the malicious app directly to the infotainment system."
                                }
                            ]
                        },
                        {
                            "vector_id": "vector_2",
                            "vector_name": "Phishing Users into Installing Malware",
                            "scenarios": [
                                {
                                    "scenario_id": "scenario_3",
                                    "scenario_description": "Attacker creates a phishing campaign targeting users. The campaign includes misleading advertisements or emails that trick users into downloading and installing the malicious app from an untrusted source."
                                },
                                {
                                    "scenario_id": "scenario_4",
                                    "scenario_description": "Attacker uses social engineering techniques to convince infotainment system administrators to manually install a malicious app, bypassing automated vetting processes."
                                }
                            ]
                        }
                    ],
                    "controls": [
                        {
                            "control_id": "AC-1",
                            "control_name": "Access Control Policy for App Stores",
                            "control_description": "Implement a strict policy to validate and approve apps before they are made available in the infotainment system's app store.",
                            "control_type": "Preventive",
                            "implementation_priority": "High"
                        },
                        {
                            "control_id": "SC-1",
                            "control_name": "Real-time Monitoring for Malware Detection",
                            "control_description": "Deploy real-time monitoring tools to detect and prevent the installation of malicious apps on the infotainment system.",
                            "control_type": "Detective",
                            "implementation_priority": "High"
                        },
                        {
                            "control_id": "CM-1",
                            "control_name": "Secure Software Update Mechanism",
                            "control_description": "Ensure that software updates for the infotainment system are securely delivered and installed, preventing unauthorized installations.",
                            "control_type": "Preventive",
                            "implementation_priority": "High"
                        },
                        {
                            "control_id": "PE-1",
                            "control_name": "Physical Security Controls for SD Cards",
                            "control_description": "Implement physical security measures to control access to SD cards and other media used for app installation.",
                            "control_type": "Preventive",
                            "implementation_priority": "High"
                        }
                    ]
                },
                {
                    "name": "Denial of Service",
                    "objectives": [
                        "Disrupt vehicle functionality",
                        "Cause inconvenience to passengers"
                    ],
                    "vectors": [
                        {
                            "vector_id": "vector_1",
                            "vector_name": "Resource Exhaustion",
                            "scenarios": [
                                {
                                    "scenario_id": "scenario_1",
                                    "scenario_description": "The attacker sends a high volume of invalid requests to the infotainment system, overwhelming its processing capabilities and leading to system crashes or unresponsiveness."
                                },
                                {
                                    "scenario_id": "scenario_2",
                                    "scenario_description": "An attacker exploits known vulnerabilities in the infotainment software to send continuous updates or notifications, which consume excessive bandwidth and processing power."
                                }
                            ]
                        },
                        {
                            "vector_id": "vector_2",
                            "vector_name": "Malware Infection",
                            "scenarios": [
                                {
                                    "scenario_id": "scenario_3",
                                    "scenario_description": "A malicious payload is delivered through the infotainment system's software updates, causing it to run unnecessary processes and consume CPU and memory resources."
                                },
                                {
                                    "scenario_id": "scenario_4",
                                    "scenario_description": "The attacker injects a virus that continuously scans for available network connections, leading to increased data usage and potential denial of service by exhausting the vehicle's internet connection."
                                }
                            ]
                        }
                    ],
                    "controls": [
                        {
                            "control_id": "AC-1",
                            "control_name": "Access Control Policy",
                            "control_description": "Implement and maintain an access control policy that restricts unauthorized access to the infotainment system.",
                            "control_type": "Preventive",
                            "implementation_priority": "High"
                        },
                        {
                            "control_id": "SC-1",
                            "control_name": "Software Integrity Checks",
                            "control_description": "Ensure all software components of the infotainment system undergo regular integrity checks to prevent tampering and unauthorized access.",
                            "control_type": "Preventive",
                            "implementation_priority": "High"
                        },
                        {
                            "control_id": "SC-2",
                            "control_name": "Intrusion Detection System (IDS)",
                            "control_description": "Deploy an IDS that monitors network traffic for signs of Denial of Service attacks and triggers alerts or responses as necessary.",
                            "control_type": "Detective",
                            "implementation_priority": "High"
                        },
                        {
                            "control_id": "SC-3",
                            "control_name": "Rate Limiting Mechanisms",
                            "control_description": "Implement rate limiting to prevent excessive requests that could lead to a Denial of Service condition.",
                            "control_type": "Preventive",
                            "implementation_priority": "High"
                        },
                        {
                            "control_id": "SC-4",
                            "control_name": "Fail-Safe Mechanisms",
                            "control_description": "Design and implement fail-safe mechanisms that can automatically recover from or mitigate Denial of Service attacks.",
                            "control_type": "Corrective",
                            "implementation_priority": "High"
                        }
                    ]
                }
            ],
            "consequences": [
                "Exposure of personal data",
                "Disruption of services",
                "Unauthorized access to vehicle controls",
                "Damage to user experience and trust"
            ]
        }
    ]
}